# Copy to .env and fill in. NEVER commit .env.

# Required: Gemma 4 through the Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Whisper large-v3 speech-to-text, hosted by Groq (https://console.groq.com/keys). Optional:
# without it the app uses local faster-whisper (install requirements-local-stt.txt).
GROQ_API_KEY=
STT_BACKEND=auto            # auto | groq | local
WHISPER_LOCAL_MODEL=small   # only for the local backend

# Text to speech
TTS_PRELOAD=hi,bn           # languages to load at startup (faster first reply)
TTS_BACKEND=auto            # auto = MMS-TTS then gTTS fallback; gtts = skip MMS

# App
PORT=5000
DB_PATH=data/team_j.db
RATE_LIMIT_PER_MIN=40       # per IP, 0 disables
MAX_UPLOAD_MB=12
DEFAULT_CITY=Haldia
